<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvDialogMembersTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👥 Quản Lý Thành Viên Nhóm"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Mời bạn bè &amp; người thân cùng tham gia lập kế hoạch"
        android:textColor="#777778"
        android:textSize="12sp" />

    <!-- Form Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email người tham gia"
        android:textColor="#888888"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/edtMemberEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:hint="VD: friend@gmail.com"
        android:inputType="textEmailAddress"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quyền hạn trong chuyến đi"
        android:textColor="#888888"
        android:textSize="11sp" />

    <Spinner
        android:id="@+id/spnMemberRole"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_input"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <Button
        android:id="@+id/btnInviteMember"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_button_primary"
        android:text="+ Mời Thành Viên Mới"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#E0E0E0" />

    <!-- List Section Header -->
    <TextView
        android:id="@+id/tvMemberListHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Danh sách thành viên hiện tại"
        android:textColor="#1A1A1A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Dynamic Member List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTripMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- Close Action -->
    <Button
        android:id="@+id/btnCloseMembers"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:text="Đóng"
        android:textAllCaps="false"
        android:textColor="#555555"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
