<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogExpenseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Thêm Khoản Chi Tiêu Mới"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mô tả khoản chi"
        android:textColor="#888888"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/edtDialogDesc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:hint="VD: Ăn tối lẩu gà, Vé xem phim..."
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số tiền (VND)"
        android:textColor="#888888"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/edtDialogAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:hint="VD: 900000"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh mục"
        android:textColor="#888888"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/edtDialogCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:hint="FOOD, TICKET, ACCOMMODATION..."
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="FOOD"
        android:textSize="14sp" />

    <!-- Chia Tiền Nhóm (Expense Splitting) -->
    <CheckBox
        android:id="@+id/cbEnableSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="👥  Chia tiền cho các thành viên nhóm"
        android:textColor="#007AFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutSplitDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#F0F4F8"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số người chia tiền"
            android:textColor="#666666"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/edtNumPeople"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input"
            android:hint="2"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSplitResultPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="💡 Mỗi người trả: 0đ"
            android:textColor="#00C853"
            android:textSize="13sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbIsSettled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã quyết toán / Hoàn tất trả tiền"
            android:textColor="#333333"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancelExpense"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#F0F4F8"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnDialogSaveExpense"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="Lưu khoản chi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
