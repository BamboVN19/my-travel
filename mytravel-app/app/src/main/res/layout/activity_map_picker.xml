<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/headerMap"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBackMap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chọn vị trí trên bản đồ Google Maps"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Map Preview Background Frame -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomConfirmCard"
        android:layout_below="@id/headerMap"
        android:background="#E1F5FE">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="🗺️\nGoogle Maps Simulation\n(Kéo thả ghim vị trí)"
            android:textColor="#007AFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Pin Point Center -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="📍"
            android:textSize="40sp" />
    </RelativeLayout>

    <!-- Bottom Confirm Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomConfirmCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvPinLocationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hồ Hoàn Kiếm, Hà Nội"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPinLocationCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Tọa độ: 21.0285° N, 105.8542° E"
                android:textColor="#888888"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConfirmMapLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#00A3FF"
                android:text="Xác nhận vị trí này"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
