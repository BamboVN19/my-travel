            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ngocdai\",\n  \"email\": \"ngocdai@mytravel.com\",\n  \"password\": \"Password123@\",\n  \"fullName\": \"Bùi Ngọc Đại\",\n  \"phone\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "1.2 Đăng nhập (Login - Auto Saves Tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', res.accessToken);",
                  "    console.log('Saved accessToken:', res.accessToken);",
                  "}",
                  "if (res.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', res.refreshToken);",
